# Backend Staging Environment Configuration
# Copy this to backend/.env or set as environment variables

# ============================================
# Port Configuration - Staging (192.168.3.155)
# ============================================

# Main Backend WebSocket Server - 192.168.3.155:8147
EFS_BACKEND_PORT=8247

# Floor Map Server - 192.168.3.155:8144
FLOOR_MAP_PORT=8244

# RAG Bot API Server - 192.168.3.155:8145 (backend calls internally, use internal URL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=efs_vms_chatbot
# Mock API Server (OIDC & Testing) - runs on 192.168.3.155:8146
# MUST match VITE_OIDC_AUTHORITY - OIDC discovery document uses this as issuer.
# When accessed via https://vms2.0.haloocom.in, set to public URL so discovery returns correct endpoints.
# Original internal: http://192.168.3.155:8146
MOCK_API_PORT=8246
## MOCK_API_PORT=3000
# MOCK_API_BASE_URL=https://vms2.0.haloocom.in/oidc
MOCK_API_BASE_URL=https://chatbot.haloocom.in/mockapi1
